generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Registration {
  id          String   @id @default(cuid())
  fullName    String
  phoneNumber String
  tgUsername  String
  location    String
  batch       String
  faculty     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Admin {
  id                     String    @id @default(cuid())
  email                  String    @unique
  passwordHash           String
  requiresPasswordChange Boolean   @default(true)
  lastLoginAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}
